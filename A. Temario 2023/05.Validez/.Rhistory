require(XLConnect)
library(stringr)
# ---------------------------------------------------
individual <- function(base, f, nombre){
d = readWorksheetFromFile(f, sheet = 1)
d <- d[d$filtro==1,c("email","nota")]
names(d)[2] <- nombre
return(merge(base, d, by="email", all.x = T))
}
grupal <- function(base, f, nombre){
d = readWorksheetFromFile(f, sheet = 1)
d <- d[d$filtro==1,c("email","nota", "Respuesta.1")]
base[nombre] <- NA
for (i in 1:nrow(d)){
g <- str_extract_all(d[i,'Respuesta.1'], "\\b\\w*@ucm.es")
for (j in 1:length(g[[1]])){
base[which(base$email==g[[1]][j]),nombre] <- d[i, "nota"]
}
}
return(base)
}
